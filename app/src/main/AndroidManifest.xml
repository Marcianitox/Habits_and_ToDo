<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para mostrar los recordatorios de deadlines -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HabitsAndToDo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HabitsAndToDo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ventanita flotante de carga rápida (desde los widgets) -->
        <activity
            android:name=".ActividadCargaRapida"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.HabitsAndToDo.Flotante"
            android:windowSoftInputMode="adjustResize" />

        <!-- Widget: plan del día -->
        <receiver
            android:name=".widget.ReceptorPlanDelDia"
            android:exported="true"
            android:label="Plan del día">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_plan_info" />
        </receiver>

        <!-- Widget: hábitos -->
        <receiver
            android:name=".widget.ReceptorHabitos"
            android:exported="true"
            android:label="Hábitos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_habitos_info" />
        </receiver>

        <!-- Widget: deadlines -->
        <receiver
            android:name=".widget.ReceptorDeadlines"
            android:exported="true"
            android:label="Deadlines">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_deadlines_info" />
        </receiver>

        <!-- Widget: semana y calendario de hábitos -->
        <receiver
            android:name=".widget.ReceptorGraficoHabitos"
            android:exported="true"
            android:label="Semana de hábitos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_grafico_info" />
        </receiver>
    </application>

</manifest>