<?xml version="1.0" encoding="utf-8"?>
<!-- Monograma "H": trazos verdes unidos por un tilde naranja -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Trazo izquierdo (menta) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF3FB39A"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M40,36L40,72" />

    <!-- Trazo derecho (menta) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF3FB39A"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:pathData="M68,36L68,72" />

    <!-- Borde del tilde, del color del fondo: lo separa de los trazos -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF1F2B4D"
        android:strokeWidth="14"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,54L51,64L68,45" />

    <!-- Tilde (naranja) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFF5A03A"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40,54L51,64L68,45" />
</vector>